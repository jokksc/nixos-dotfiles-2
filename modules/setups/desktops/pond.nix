# Pond — Butterfly's niri-based desktop shell
# ---
# Pond (https://github.com/bflycomputer/pond-interface) is a quickshell-based
# desktop shell for niri: wallpaper manager, modular sidebar, notifications,
# calendar, media/brightness/bluetooth/wifi panels, a session lockscreen and an
# SDDM greeter that boots into niri. It's the shell of Butterfly's Arch-based
# distro; this module packages the upstream quickshell sources for NixOS
# (mirroring their PKGBUILDs in bflycomputer/pond-pkgbuilds).
#
# Usage: import this file INSTEAD of gnome.nix / niri.nix in a host's
# configuration.nix (it starts SDDM and would clash with GDM):
#
#   ../../modules/setups/desktops/pond.nix
#
# Everything is opt-out-able through `programs.pond.*` below.
#
# How it works:
#   * `inputs.pond` is the raw quickshell/CMake source tree (flake = false).
#   * pond-qml-modules builds the C++ QML plugins (Pond.System, Pond.Screenshot.
#     Native) and assembles all `Pond.*` QML modules into `lib/qt-6/qml` — that
#     directory is put on the QML import path system-wide (nixpkgs patches Qt
#     to also read the `NIXPKGS_QT6_QML_IMPORT_PATH` env var).
#   * pond-interface ships the shell/lockscreen/greeter/niri-config trees under
#     `share/pond-interface` (upstream's hardcoded `/usr/share/pond-interface`
#     and `/usr/bin/*` paths are patched to store / system-profile paths), plus
#     PATH-wrapped `pond-shell` / `pond-lock` / `pond-suspend` wrappers.
#   * The niri config is generated by home-manager (binds + NVIDIA debug), then
#     pond's own KDL is appended via `include` statements — the same skel
#     layout upstream uses, so the shell's settings panels can rewrite
#     `~/.config/niri/cfg/*.kdl`.
#
# Keybind differences vs modules/home/niri.nix (pond's included config.kdl owns
# these): Mod+Space launcher, Mod+V clipboard, Mod+K switch-layout, Mod+L lock,
# all XF86 media/brightness keys → routed through the pond shell via IPC.
{ lib, options, config, pkgs, inputs, ... }:

let
  cfg = config.programs.pond;
  system = pkgs.stdenv.hostPlatform.system;

  # Upstream quickshell/CMake sources (no flake, hence flake = false input).
  pondSrc = inputs.pond;
  pondDate = "2026-11-20";

  # Python used by the shell's settings panels / wallpaper / bluetooth helper.
  # Needs PyQt6 + PyGObject, so the QML files are patched to call this
  # interpreter by absolute path instead of bare `python3`.
  pythonEnv = pkgs.python3.withPackages (ps: with ps; [
    pyqt6
    pygobject3
  ]);

  runtimePath = lib.makeBinPath (
    with pkgs;
    [
      quickshell
      pythonEnv
      fastfetch
      networkmanager # nmcli
      iw
      zenity
      brightnessctl
      ddcutil
      upower
      systemd # systemctl
      pulseaudio # pactl
      wl-clipboard
      coreutils
    ]
  );

  # Store paths of the Qt/wayland/glib libraries the C++ QML plugins link.
  qtLibPath = lib.makeLibraryPath (with pkgs; [
    qt6.qtbase
    qt6.qtdeclarative
    qt6.qtsvg
    kdePackages.networkmanager-qt
    wayland
    glib
    stdenv.cc.cc
  ]);

  # ── C++ QML plugins + pure-QML Pond.* modules ──────────────────────────
  # Installed into lib/qt-6/qml so every Qt app (quickshell, the SDDM greeter)
  # can `import Pond.*` via the nixpkgs-patched import path env var.
  pondQml = pkgs.stdenv.mkDerivation {
    pname = "pond-qml-modules";
    version = "0.2.2-unstable-${pondDate}";

    src = pondSrc;

    nativeBuildInputs = with pkgs; [
      cmake
      ninja
      pkg-config # KF6NetworkManagerQt's cmake config pkg-searches gio-2.0
      autoPatchelfHook # gives the QML plugins proper rpaths in the store
    ];
    # QML plugin libraries, not wrapped applications.
    dontWrapQtApps = true;

    # Pond asks for Qt >= 6.12; nixpkgs' qt6 is a minor release behind. Relax
    # the floor — remove this once your nixpkgs pin ships Qt 6.12.
    postPatch = ''
      substituteInPlace CMakeLists.txt --replace-fail 'Qt6 6.12' 'Qt6 6.11'
    '';
    buildInputs = with pkgs; [
      qt6.qtbase
      qt6.qtdeclarative
      qt6.qtsvg
      kdePackages.networkmanager-qt
      glib
      wayland
    ];

    configurePhase = ''
      runHook preConfigure
      # NOTE: -S . (not $src) so the postPatch'd source tree is used.
      # BUILD_WITH_INSTALL_RPATH bakes the install rpath at build time (no
      # /build references in the installed .so); autoPatchelfHook then
      # tightens it up.
      cmake -S . -B build-system -G Ninja \
        -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON \
        -DCMAKE_INSTALL_RPATH='$ORIGIN:${qtLibPath}' \
        -DCMAKE_PREFIX_PATH="${
          lib.makeSearchPath "lib/cmake" [
            (lib.getDev pkgs.qt6.qtbase)
            (lib.getDev pkgs.qt6.qtdeclarative)
            (lib.getDev pkgs.qt6.qtsvg)
            (lib.getDev pkgs.kdePackages.networkmanager-qt)
          ]
        }"
      cmake -S screenshot/native -B build-shot -G Ninja \
        -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON \
        -DCMAKE_INSTALL_RPATH='$ORIGIN:${qtLibPath}' \
        -DCMAKE_INSTALL_PREFIX=/ \
        -DCMAKE_PREFIX_PATH="${
          lib.makeSearchPath "lib/cmake" [
            (lib.getDev pkgs.qt6.qtbase)
            (lib.getDev pkgs.qt6.qtdeclarative)
            (lib.getDev pkgs.qt6.qtsvg)
          ]
        }" \
        -DCMAKE_INSTALL_RPATH='$ORIGIN'
      runHook postConfigure
    '';

    buildPhase = ''
      runHook preBuild
      cmake --build build-system --target pond_systemplugin
      cmake --build build-shot
      runHook postBuild
    '';

    installPhase = ''
      runHook preInstall
      mkdir -p "$out/lib/qt-6/qml/Pond/System" "$out/lib/qt-6/qml/Pond/Screenshot"

      # Pond.System — C++ QML plugin (Logind / NetworkStatus / CapsLock).
      # Mirrors the upstream pond-lockscreen PKGBUILD layout.
      cp -r build-system/Pond/System/. "$out/lib/qt-6/qml/Pond/System/"
      install -Dm755 build-system/libpond_system.so \
        -t "$out/lib/qt-6/qml/Pond/System/"

      # Pond.Screenshot (+ Pond.Screenshot.Native C++ drag plugin).
      cp "$src/screenshot/qmldir" "$src/screenshot/State.qml" \
        "$src/screenshot/Preview.qml" "$src/screenshot/clipboard.py" \
        "$out/lib/qt-6/qml/Pond/Screenshot/"
      cp -r "$src/screenshot/assets" "$out/lib/qt-6/qml/Pond/Screenshot/assets"
      DESTDIR="$out/qml-install" cmake --install build-shot
      cp -r "$out/qml-install/lib/qt6/qml/Pond/Screenshot/Native" \
        "$out/lib/qt-6/qml/Pond/Screenshot/Native"
      rm -rf "$out/qml-install"

      # Pond.Wallpaper (layer-shell wallpaper) — pure QML + prebuilt shaders.
      mkdir -p "$out/lib/qt-6/qml/Pond/Wallpaper" "$out/lib/qt-6/qml/Pond/Daylight"
      cp "$src/wallpaper/desktop/qmldir" "$src/wallpaper/desktop/Window.qml" \
        "$src/wallpaper/desktop/Content.qml" "$src/wallpaper/desktop/Reveal.qml" \
        "$src/wallpaper/desktop/dither.frag.qsb" \
        "$out/lib/qt-6/qml/Pond/Wallpaper/"
      cp "$src/wallpaper/daylight/qmldir" "$src/wallpaper/daylight/Sky.qml" \
        "$src/wallpaper/daylight/SkyState.js" "$src/wallpaper/daylight/sky.frag.qsb" \
        "$out/lib/qt-6/qml/Pond/Daylight/"
      runHook postInstall
    '';

    meta = {
      description = "Pond C++/QML modules (Pond.System, Pond.Wallpaper, Pond.Daylight, Pond.Screenshot)";
      license = lib.licenses.bsd3;
      platforms = lib.platforms.linux;
    };
  };

  # ── The interface itself (shell, lockscreen, greeter, niri config) ─────
  pondPkg = pkgs.stdenvNoCC.mkDerivation {
    pname = "pond-interface";
    version = "0.2.2-unstable-${pondDate}";

    src = pondSrc;

    nativeBuildInputs = with pkgs; [
      makeWrapper
    ];

    installPhase = ''
      runHook preInstall
      local share="$out/share/pond-interface"
      mkdir -p "$share" "$out/bin"

      cp -r shell lockscreen config "$share/"
      mkdir -p "$share/wallpaper"
      cp -r wallpaper/control.py wallpaper/catalog.json "$share/wallpaper/"
      cp -r wallpaper/included "$share/wallpaper/included"
      rm -rf "$share/shell/settings/information/__pycache__"

      # Rewrite upstream's hardcoded paths for the store + NixOS:
      #   /usr/share/pond-interface → this package's share dir
      #   "/usr/bin/…               → the system profile
      #   bare "python3"            → our PyQt6 interpreter
      #   the niri-config spawn of the shell → our PATH-wrapped launcher
      substituteInPlace "$share/shell/shell.qml" \
        --replace-fail '/usr/share/pond-interface' "$share"
      substituteInPlace "$share/shell/settings/session.py" \
        --replace-fail '/usr/share/pond-interface' "$share"
      find "$share" \( -name '*.qml' -o -name '*.py' -o -name '*.kdl' \) -type f | while read -r f; do
        sed -i -e "s|/usr/share/pond-interface|$share|g" \
               -e 's|/usr/bin/|/run/current-system/sw/bin/|g' \
               -e 's|"python3"|"${pythonEnv}/bin/python3"|g' "$f"
      done
      sed -i -e 's|"qs -c pond-shell"|"'"$out"'/bin/pond-shell"|g' \
        "$share/config/niri/shell/config.kdl"

      # PATH-wrapped quickshell so every `qs`/`python3`/… child sees its tools.
      makeWrapper "${pkgs.quickshell}/bin/qs" "$out/bin/pond-shell" \
        --add-flags "-c pond-shell" \
        --prefix PATH : "${runtimePath}"

      makeWrapper "${pythonEnv}/bin/python3" "$out/bin/pond-lock" \
        --add-flags "$share/shell/settings/session.py lock" \
        --prefix PATH : "${runtimePath}"
      makeWrapper "${pythonEnv}/bin/python3" "$out/bin/pond-suspend" \
        --add-flags "$share/shell/settings/session.py suspend" \
        --prefix PATH : "${runtimePath}"
      runHook postInstall
    '';

    meta = {
      description = "Pond desktop shell for niri (quickshell)";
      homepage = "https://github.com/bflycomputer/pond-interface";
      license = lib.licenses.bsd3;
      platforms = lib.platforms.linux;
    };
  };

  greeterDir = "${pondPkg}/share/pond-interface/lockscreen";

  # Confirmed session lock, reused by keybinds and the before-sleep hook.
  beforeSleep = pkgs.writeShellScript "pond-before-sleep" ''
    if ! ${lib.getExe' pkgs.coreutils "timeout"} 4s "${pondPkg}/bin/pond-lock"; then
      ${lib.getExe' pkgs.util-linux "logger"} -t pond-lock 'Session lock was not confirmed before sleep'
      exit 1
    fi
  '';
  idleArgs = [
    (lib.getExe pkgs.swayidle)
    "-C"
    "/dev/null"
    "-w"
    "before-sleep"
    (toString beforeSleep)
  ];

  # ── Fonts ──────────────────────────────────────────────────────────────
  # Onest (UI) and Pond Gramercy (display) aren't in nixpkgs; Advent Pro is
  # used by the clock. IBM Plex Mono + JetBrains Mono come from nixpkgs.
  # Pond Gramercy is vendored here like upstream Arch does (fetched from
  # hrtowii's dotfiles, which vendored it for the same reason).
  pondGramercyWeights = [
    "Black" "BlackItalic" "Bold" "BoldItalic" "Book" "BookItalic"
    "Light" "LightItalic" "Medium" "MediumItalic" "Regular" "RegularItalic"
    "Super" "SuperItalic" "Thin" "ThinItalic"
  ];

  pondGramercyHashes = {
    Black = "sha256-4R4ZzdL0BTn/+m2p3JzfAZvYFL/BwmJkrKNZpQUd+34=";
    BlackItalic = "sha256-0LSiDyKKoZrrCCBE3Mt17uPvo2/F7LQbou+Kh6Nwm3s=";
    Bold = "sha256-uInb+Cdn6tHsMQAj+v9yIEJJb+GjEOQpFbz5fcGdv4M=";
    BoldItalic = "sha256-McsNTAMLoHLpRRp8d9LRM/5OtxAGH+alTnhr2DGhgBo=";
    Book = "sha256-ZfMiorPmAn3OCR3u8M3l+0jQnj9GMNhsAeyQqc92piQ=";
    BookItalic = "sha256-8YAE0SZVPOFhJbqnvEl7Ejqpqd1887ZVeHpWmAipijs=";
    Light = "sha256-zYfDTRVC9lmQ4eITuVUyKfogvp+QhD+5y7cE/qWilLc=";
    LightItalic = "sha256-tp5XT6vOtyCDgiujv1MqPfUJwXkYvAoRNuSGjrRWUo4=";
    Medium = "sha256-6ivirEWOdisazmdBrS7wAti8Mkr+UDIWzhG3YvzuVHY=";
    MediumItalic = "sha256-vzMJLvzfHPCv1uBBTOdGiZflBiYFk7H5P3Rj582uh8E=";
    Regular = "sha256-5liqJMbZIaPSFgF422kcJohUZ1neolH0FJWnwJP2EHw=";
    RegularItalic = "sha256-HdUZ3SXh9p8A7DS2FcAPdDrRDlk1lj/2PHX0pHqWW/4=";
    Super = "sha256-JIze+6PGjJSCphzDZ78GF/jC5w9at6iM86cvz8zhNbI=";
    SuperItalic = "sha256-cN/REc6b3e6gHcRnd6nUpDh0NFGgQax8fQyzjkAYyvg=";
    Thin = "sha256-cO+bAuzUE5J7OkpoV51+za2ZM/4MDLuDl9j3QqhrOUo=";
    ThinItalic = "sha256-/flZmjuiOfLOlXPhflVsyZm3Vw/2LR2kuG+4RQ8hKMY=";
  };

  pondFonts = pkgs.linkFarm "pond-fonts" (
    [
      {
        name = "share/fonts/truetype/Onest.ttf";
        path = pkgs.fetchurl {
          url = "https://raw.githubusercontent.com/google/fonts/main/ofl/onest/Onest%5Bwght%5D.ttf";
          hash = "sha256-lmxcKbR1XahLaFTVwh3U6qJCAiXQ6YdN5gLeF21KnzE=";
        };
      }
      {
        name = "share/fonts/truetype/AdventPro.ttf";
        path = pkgs.fetchurl {
          url = "https://raw.githubusercontent.com/google/fonts/main/ofl/adventpro/AdventPro%5Bwdth,wght%5D.ttf";
          hash = "sha256-tgqykguJvcS32t+ygsraxuA4M+eoCET56sCWNZsrl2Y=";
        };
      }
    ]
    ++ map (weight: {
      name = "share/fonts/opentype/PondGramercy-${weight}.otf";
      path = pkgs.fetchurl {
        url = "https://raw.githubusercontent.com/hrtowii/dotfiles/53b79a0a01b52e7156d47dbe7d0c65dbc7abe8c3/nixos/home-manager/fonts/otf-pond-gramercy/PondGramercy-${weight}.otf";
        hash = pondGramercyHashes.${weight};
      };
    }) pondGramercyWeights
  );

  # ── Plymouth theme ─────────────────────────────────────────────────────
  pondPlymouth = pkgs.runCommand "pond-plymouth-theme" { } ''
    install -Dm644 -t "$out/share/plymouth/themes/pond" \
      "${pondSrc}/plymouth/pond.plymouth" "${pondSrc}/plymouth/pond.script"
    install -Dm644 -t "$out/share/plymouth/themes/pond/assets" \
      "${pondSrc}"/plymouth/assets/*.png
  '';

  # Seed for ~/.config/niri/cfg/input.kdl (pond's input settings panel owns it
  # afterwards) — starts from this host's keyboard/touchpad preferences.
  pondInputSeed = pkgs.writeText "pond-input.kdl" ''
    input {
        keyboard {
            xkb {
                layout "us,ru"
                options "grp:alt_shift_toggle"
            }
            numlock
            track-layout "window"
        }
        touchpad {
            tap
            natural-scroll
            dwt
        }
        mouse {
            accel-profile "flat"
            natural-scroll
        }
        focus-follows-mouse
        workspace-auto-back-and-forth
    }
  '';

  # cfg/*.kdl files the niri config includes (keybinds.kdl is deliberately not
  # included — those binds live in the home-manager settings below).
  pondCfgFiles = [
    "animation"
    "autostart"
    "display"
    "input"
    "layout"
    "misc"
    "rules"
  ];
in
{
  options.programs.pond = {
    enable = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Enable the Pond desktop shell. Importing this module opts you in; set to false to make it a no-op.";
    };

    shell.enable = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Install the Pond quickshell shell (started from niri's included config.kdl).";
    };

    lockscreen.enable = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Pond session lockscreen (quickshell session-lock + PAM) and idle locking.";
    };

    greeter.enable = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Use the Pond SDDM greeter (niri-backed login screen). Conflicts with GDM.";
    };

    plymouth.enable = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Butterfly's plymouth boot animation.";
    };

    fastfetch.enable = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "fastfetch (system info panel in the shell).";
    };

    niri.enable = lib.mkOption {
      type = lib.types.bool;
      default = true;
      description = "Home-manager niri integration: pond keybinds, autostart and config includes.";
    };
  };

  config = lib.mkIf cfg.enable (
    lib.mkMerge (
      [
      {
        # niri itself — pond needs recent niri (layer-rule background-effect
        # etc.), so use the flake's unstable build instead of niri-stable.
        programs.niri.enable = true;
        programs.niri.package = lib.mkDefault inputs.niri.packages.${system}.niri-unstable;

        fonts.packages = [
          pondFonts
          pkgs.jetbrains-mono
          pkgs.ibm-plex
        ];

        environment.systemPackages =
          with pkgs;
          [
            pondPkg
            quickshell
            capitaine-cursors
            xdg-utils
            wl-clipboard
          ]
          ++ lib.optional cfg.fastfetch.enable fastfetch
          ++ lib.optional cfg.shell.enable swayidle;

        environment.sessionVariables = {
          NIXOS_OZONE_WL = "1";
          NIXPKGS_QT6_QML_IMPORT_PATH = [ "${pondQml}/lib/qt-6/qml" ];
        } // lib.optionalAttrs cfg.lockscreen.enable {
          POND_PAM_SERVICE = "pond-lockscreen";
        };

        # GTK defaults from upstream (dark theme) for GTK apps like nautilus.
        # mkDefault so other modules (stylix etc.) can override.
        environment.etc = {
          "xdg/gtk-3.0/settings.ini".source = lib.mkDefault "${pondPkg}/share/pond-interface/config/gtk-3.0/settings.ini";
          "xdg/gtk-4.0/settings.ini".source = lib.mkDefault "${pondPkg}/share/pond-interface/config/gtk-4.0/settings.ini";
        };

        # Desktop services the shell talks to over DBus.
        services.upower.enable = true;
        services.power-profiles-daemon.enable = true;
        services.pipewire = {
          enable = lib.mkDefault true;
          pulse.enable = lib.mkDefault true;
        };
        networking.networkmanager.enable = lib.mkDefault true;
        hardware.bluetooth.enable = lib.mkDefault true;
      }

      (lib.mkIf cfg.lockscreen.enable {
        # quickshell's PamContext reads $POND_PAM_SERVICE from /etc/pam.d.
        security.pam.services.pond-lockscreen = { };
      })

      (lib.mkIf cfg.plymouth.enable {
        boot.plymouth = {
          enable = true;
          theme = "pond";
          themePackages = [ pondPlymouth ];
        };
      })
    ]
    ++ lib.optionals (options ? stylix) [
      # Keep stylix from fighting over the boot splash.
      (lib.mkIf cfg.plymouth.enable { stylix.targets.plymouth.enable = false; })
    ]
    ++ [

      (lib.mkIf cfg.greeter.enable {
        # Pond's greeter is an SDDM theme whose Main.qml is loaded inside niri
        # (upstream ships the exact same sddm.conf.d snippet).
        services.displayManager.sddm = {
          enable = true;
          wayland.enable = true;
          theme = "greeter";
          settings = {
            General.GreeterEnvironment = "NIXPKGS_QT6_QML_IMPORT_PATH=${pondQml}/lib/qt-6/qml";
            Theme.ThemeDir = greeterDir;
            Wayland.CompositorCommand =
              "${lib.getExe config.programs.niri.package} --config ${greeterDir}/greeter/niri.kdl";
          };
          extraPackages = [ pondPkg pondQml ];
        };
      })

      (lib.mkIf cfg.niri.enable {
        home-manager.sharedModules = [
          ({ config, lib, pkgs, ... }: {
            # niri-flake has no raw-kdl setting for pond's config, so append
            # pond's includes the way hrtowii's setup does.
            options.programs.niri.finalConfig = lib.mkOption {
              apply =
                kdl:
                if kdl == null then
                  null
                else
                  kdl
                  + "\n"
                  # optional=true keeps `niri validate` (run by niri-flake at
                  # build time) happy before the files exist on disk.
                  + ''
                    include "./shell/config.kdl" optional=true
                  ''
                  + lib.concatMapStrings (f: ''
                    include "./cfg/${f}.kdl" optional=true
                  '') pondCfgFiles;
            };
          })

          ({ config, lib, pkgs, ... }: {
            programs.niri.settings = {
              # NOTE: Mod+Space (launcher), Mod+V (clipboard), Mod+K (switch
              # layout), Mod+L (lock) and all XF86 media/brightness keys come
              # from pond's own included config.kdl — don't rebind them here.
              binds = {
                # Window management
                "Mod+Return".action.spawn = "alacritty";
                "Mod+Q".action.close-window = { };
                "Mod+F".action.maximize-column = { };
                "Mod+Shift+F".action.fullscreen-window = { };
                "Mod+W".action.toggle-column-tabbed-display = { };
                # Mod+V is clipboard history in pond; floating lives here now.
                "Mod+O".action.toggle-window-floating = { };

                # Focus (Mod+L = lock in pond, Mod+K = switch layout)
                "Mod+H".action.focus-column-left = { };
                "Mod+Semicolon".action.focus-column-right = { };
                "Mod+J".action.focus-window-down = { };
                "Mod+Up".action.focus-window-up = { };
                "Mod+Down".action.focus-window-down = { };
                "Mod+Right".action.focus-column-right = { };
                "Mod+Left".action.focus-column-left = { };

                "Mod+Shift+H".action.move-column-left = { };
                "Mod+Shift+Semicolon".action.move-column-right = { };
                "Mod+Shift+J".action.move-window-down = { };
                "Mod+Shift+Up".action.move-window-up = { };
                "Mod+Shift+Down".action.move-window-down = { };
                "Mod+Shift+Left".action.move-column-left = { };
                "Mod+Shift+Right".action.move-column-right = { };

                # Sizing
                "Mod+R".action.switch-preset-column-width = { };
                "Mod+Minus".action.set-column-width = "-10%";
                "Mod+Equal".action.set-column-width = "+10%";

                # Workspaces
                "Mod+1".action.focus-workspace = 1;
                "Mod+2".action.focus-workspace = 2;
                "Mod+3".action.focus-workspace = 3;
                "Mod+4".action.focus-workspace = 4;
                "Mod+5".action.focus-workspace = 5;
                "Mod+Shift+1".action.move-column-to-workspace = 1;
                "Mod+Shift+2".action.move-column-to-workspace = 2;
                "Mod+Shift+3".action.move-column-to-workspace = 3;
                "Mod+Shift+4".action.move-column-to-workspace = 4;
                "Mod+Shift+5".action.move-column-to-workspace = 5;

                # Screenshots — niri's built-in actions; the pond shell listens
                # on niri's event stream and opens its own preview overlay.
                "Mod+S".action.screenshot = { };
                "Print".action.screenshot = { };
                "Mod+Print".action.screenshot-window = { };
                "Ctrl+Print".action.screenshot-screen = { };

                # Help + session
                "Mod+Shift+Slash".action.show-hotkey-overlay = { };
                "Mod+Shift+E".action.quit = { };
              };

              # NVIDIA: pin the render device like modules/home/niri.nix does.
              # Pond's misc.kdl sets other debug flags; sections merge across
              # includes.
              debug."render-drm-device" = "/dev/dri/renderD128";

              # Belt and braces: even if the shell is down, make sure the
              # session is locked right before suspend.
              spawn-at-startup = lib.mkIf cfg.lockscreen.enable (
                lib.mkAfter [ { argv = idleArgs; } ]
              );
            };

            home.packages = [ pkgs.capitaine-cursors ];

            # `qs -c pond-shell` resolution (like upstream's /etc/xdg symlink).
            home.file.".config/quickshell/pond-shell".source =
              "${pondPkg}/share/pond-interface/shell";

            # pond's niri includes reference ./shell/*.kdl (read-only defaults).
            home.file.".config/niri/shell".source =
              "${pondPkg}/share/pond-interface/config/niri/shell";

            # Seed the editable cfg/*.kdl files once (skel-style). Copy-if-
            # missing, so the shell's settings panels can rewrite them and your
            # edits survive rebuilds.
            home.activation.pondNiriCfg = lib.hm.dag.entryAfter [ "writeBoundary" ] (''
              cfgDir="$HOME/.config/niri/cfg"
              mkdir -p "$cfgDir"
            ''
            + lib.concatMapStringsSep "\n"
              (f: ''[ -f "$cfgDir/${f}.kdl" ] || cp "${pondPkg}/share/pond-interface/config/niri/cfg/${f}.kdl" "$cfgDir/${f}.kdl"'')
              (lib.remove "input" pondCfgFiles)
            + ''
              [ -f "$cfgDir/input.kdl" ] || cp "${pondInputSeed}" "$cfgDir/input.kdl"

              # Pond Screenshot / wallpaper want somewhere to live.
              mkdir -p "$HOME/.config/pond-interface" "$HOME/Pictures/Wallpapers"
            '');
          })
        ];
      })
      ]
    )
  );
}
